# Database
DATABASE_URL="postgresql://user:password@localhost:5432/caseflo?schema=public"

# AI / Gemini
GEMINI_API_KEY="your-gemini-api-key"

# Payments / Flutterwave
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxx-X"
FLUTTERWAVE_WEBHOOK_HASH="your-secret-webhook-hash"

# Session Secrets (Must be min 32 characters in production)
SESSION_SECRET="client-session-cookie-secret-key-at-least-32-chars"
STAFF_SESSION_SECRET="staff-session-cookie-secret-key-at-least-32-chars"

# Storage / AWS S3
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="caseflo-documents"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

